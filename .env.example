# Copy to .env for local development. Never commit real credentials.
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=coursegraph-dev
COURSEGRAPH_BACKEND=neo4j
COURSEGRAPH_API_URL=http://localhost:8000
LOG_LEVEL=INFO

# Optional: LLM Orchestration ("none", "openai", "gemini")
# Default "none" uses the fast, deterministic 0ms/0-cost router (no API keys required)
LLM_PROVIDER=none
LLM_MODEL=gpt-4o-mini
OPENAI_API_KEY=
GEMINI_API_KEY=
OPENAI_BASE_URL=

